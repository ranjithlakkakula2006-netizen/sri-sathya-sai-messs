# Sri Sathya Sai Mess - Environment Variables
# AI Studio automatically injects GEMINI_API_KEY and APP_URL at runtime.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Razorpay Payment Gateway Credentials (Server-side Only)
# Obtain from Razorpay Dashboard -> Account & Settings -> API Keys (Test or Live)
# Note: Key Secret is kept exclusively on the server and NEVER exposed to frontend clients
RAZORPAY_KEY_ID="rzp_test_YourKeyId"
RAZORPAY_KEY_SECRET="YourRazorpaySecretKey"
# Optional: Set this if configuring webhooks in Razorpay Dashboard -> Webhooks
RAZORPAY_WEBHOOK_SECRET="YourWebhookSecret"

# WhatsApp Business API / Messaging Configuration
# Meta WhatsApp Cloud API credentials
WHATSAPP_PHONE_NUMBER_ID="your_whatsapp_phone_number_id"
WHATSAPP_ACCESS_TOKEN="your_meta_system_user_access_token"
# Owner phone number with country code (e.g. 919876543210 for India)
RESTAURANT_OWNER_WHATSAPP="919876543210"

# Admin Emergency Master Password / Secret (used if Supabase Auth is not yet configured)
OWNER_ADMIN_EMAIL="owner@srisathyasaimess.com"
OWNER_ADMIN_PASSWORD="SaiMessAdmin@2026"

# Email Delivery (SMTP) for Password Reset Instructions (Optional but recommended for production)
# For Gmail: Use smtp.gmail.com, port 587, your gmail address, and a 16-character Google App Password (not your normal password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="ranjithlakkakula2006@gmail.com"
SMTP_PASS="your_16_char_google_app_password"
SMTP_FROM="Sri Sathya Sai Mess <ranjithlakkakula2006@gmail.com>"
